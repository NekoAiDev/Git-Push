<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">
  <!--
    Identity 必须替换为 Partner Center -> 应用标识 里的值：
      Name     = "程序包名称 / Package name"（形如 12345NekoAiDev.GitPush）
      Publisher= "发布者 / Publisher"（形如 CN=...）
    不要照抄下面的占位值。
  -->
  <Identity Name="[PACKAGE_NAME_FROM_PARTNER_CENTER]"
            Publisher="[PUBLISHER_FROM_PARTNER_CENTER]"
            Version="1.4.4.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>GitPush</DisplayName>
    <PublisherDisplayName>NekoAiDev</PublisherDisplayName>
    <Logo>assets/StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
  </Resources>
  <Applications>
    <Application Id="GitPush"
                 Executable="GitPush.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="GitPush"
                          Description="Git Push 工具 / Git Push Tool"
                          BackgroundColor="transparent"
                          Square150x150Logo="assets/Square150x150Logo.png"
                          Square44x44Logo="assets/Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets/Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <!-- 桌面桥 Win32 应用必须，Partner Center 提交时会自动放行 -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
